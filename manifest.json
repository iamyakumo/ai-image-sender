{
  "manifest_version": 3,
  "name": "AI Image Sender",
  "version": "0.1.0",
  "description": "Right-click any webpage image and send it to Grok, ChatGPT, Gemini, Claude, or a custom AI chat with your conversion prompt.",
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "activeTab",
    "clipboardWrite",
    "tabs"
  ],
  "host_permissions": [
    "https://grok.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "<all_urls>"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "AI Image Sender",
    "default_icon": {
      "16": "src/icons/16.png",
      "48": "src/icons/48.png",
      "128": "src/icons/128.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "src/icons/16.png",
    "48": "src/icons/48.png",
    "128": "src/icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/source-page.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": []
}
